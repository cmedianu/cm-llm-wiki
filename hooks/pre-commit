#!/usr/bin/env bash
#
# Git pre-commit gate for cm-llm-wiki vaults. Two steps, both scoped to what is
# being committed:
#   1. stamp-staged.py: set `updated:` to today on staged pages whose content
#      changed (covers edits made outside the agent's Edit/Write tools).
#   2. wiki-lint.py --staged --errors-only: block the commit on error-level
#      findings in the staged pages (invalid or missing frontmatter, broken
#      wikilinks, bad lifecycle, broken supersession), and on links elsewhere
#      that a staged deletion or rename breaks. Warnings never block; run
#      `wiki-lint.py --summary` for those.
# Takes about a second; another session's unstaged leftovers never block it.
#
# Wired into a vault's gitdir by wire-vault.sh (works with a plain .git dir or
# a `gitdir:` pointer file). The vault reaches the scripts through its
# .claude/wiki-scripts symlink, so this hook has no hardcoded repo path.
# Bypass in an emergency with `git commit --no-verify`.
set -euo pipefail

toplevel="$(git rev-parse --show-toplevel)"
scripts="$toplevel/.claude/wiki-scripts"

if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv not on PATH; skipping wiki checks (install uv or commit with --no-verify)" >&2
  exit 0
fi
if [[ ! -d "$scripts" ]]; then
  echo "pre-commit: $scripts missing; re-run wire-vault.sh (skipping wiki checks)" >&2
  exit 0
fi

cd "$toplevel"

# Nothing markdown staged (added, changed, renamed or deleted): nothing to check.
if [[ -z "$(git diff --cached --name-only -- '*.md')" ]]; then
  exit 0
fi

uv run --script "$scripts/stamp-staged.py" || true

uv run --script "$scripts/wiki-lint.py" --staged --errors-only --format md || {
  echo "pre-commit: wiki-lint found error-level issues in the staged pages - fix them (or --no-verify)" >&2
  exit 1
}
